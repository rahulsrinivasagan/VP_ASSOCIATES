# Monorepo Root .gitignore
# Dependencies
node_modules
**/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
.next/
web/.next/
out/
web/out/
build/

# Sanity Studio Outputs
sanity/.sanity/
sanity/dist/

# Testing & Coverage
coverage/

# Environment files
.env
.env.*
!.env.example
web/.env.local
sanity/.env.local

# OS & Misc
.DS_Store
Thumbs.db
*.pem
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
